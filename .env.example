# Razvojne vrijednosti. Kopiraj u .env, a .env nikad ne šalji na GitHub.
ENV=dev
APP_NAME="One Piece TCG Collection API"

# Namjerno je izabran port 5433 kako ne bi smetao PostgreSQL-u drugog projekta.
POSTGRES_DB=optcg
POSTGRES_USER=optcg_user
POSTGRES_PASSWORD=local_optcg_only_change_me
DATABASE_URL=postgresql+asyncpg://optcg_user:local_optcg_only_change_me@localhost:5433/optcg

# Potreban tek pri predavanju 3 (JWT)
JWT_SECRET=dev-only-replace-before-production
